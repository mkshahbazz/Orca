[TEMPLATE]
# Seamonk backend environment template
# ---------------------------------------------------------------------------
# LLM providers. OpenAI is primary; Gemini is the automatic server-side
# fallback when OpenAI fails (quota, exhausted credits, outage). Both keys stay
# on the server — never in the frontend, never committed.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-3.5-flash) and a comma-separated
# GEMINI_FALLBACK_MODELS chain tried when a model is overloaded.
#GEMINI_MODEL=gemini-3.5-flash
#GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash

# Weather/ocean feeds. The free Open-Meteo endpoints are rate limited BY IP and
# this backend shares its egress IP with the whole host, so marine answers can
# fail with "Daily API request limit exceeded" for reasons unrelated to this
# app. A customer key bills against your own quota and removes that coupling;
# leave it empty to keep using the free tier.
OPEN_METEO_API_KEY=

# Supabase: DATABASE_URL is the PostGIS/asyncpg connection used by the agents,
# SUPABASE_URL + SERVICE_ROLE_KEY drive query logging and media storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Public Storage bucket holding fisher-contributed photos/video (created by
# supabase/migrations/001_community_contribution.sql).
SUPABASE_STORAGE_BUCKET=community-media

# Bhashini translation (bhashini.gov.in): userID + ulcaApiKey from your profile.
# Without credentials the chat answers in English and says so.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Pre-issued inference key, used directly when the pipeline-config step cannot
# be resolved so translation keeps working with just this key.
BHASHINI_INFERENCE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seamonk.live,https://www.seamonk.live
